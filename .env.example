# NeuralStrike configuration.
# Copy to `.env` and edit. All keys can also be set via environment with the
# NEURALSTRIKE_ prefix (e.g. NEURALSTRIKE_ATTACKER_MODEL), per pydantic-settings.

# --- Local LLM brain (Attacker + Judge) ---
# Per Decision D1: the Judge is intentionally a STRONGER, DISTINCT model from
# the Attacker, so an attack run never scores itself and the judge is harder
# to confuse. The old `llama3.1` default was a fail-open bug (not installed)
# — fixed to deepseek-v3.1:671b-cloud with a startup reachability check.
NEURALSTRIKE_OLLAMA_BASE_URL=http://localhost:11434
NEURALSTRIKE_ATTACKER_MODEL=deepseek-r1
NEURALSTRIKE_JUDGE_MODEL=deepseek-v3.1:671b-cloud
# Ordered fallback chain tried when the Judge model is unreachable:
NEURALSTRIKE_JUDGE_MODEL_FALLBACKS=["kimi-k2.6:cloud","gpt-oss:120b-cloud","deepseek-r1:8b"]

# --- Reproducibility (Phase 0) ---
# Victim temperature is pinned to 0.0 so a replay with the same seed
# reproduces identical verdicts. Attacker temperature may be >0; the
# per-trial seed still makes it deterministic given the seed.
NEURALSTRIKE_VICTIM_TEMPERATURE=0.0
NEURALSTRIKE_ATTACKER_TEMPERATURE=0.7
# Skip the startup model-reachability check (tests / offline / explicit opt-in):
NEURALSTRIKE_SKIP_REACHABILITY_CHECK=false

# --- Remote target API keys (optional; only for `--target-type remote`) ---
NEURALSTRIKE_OPENAI_API_KEY=
NEURALSTRIKE_ANTHROPIC_API_KEY=

# --- Logging ---
# REDACT_LOGS=true will scrub strings that look like keys/credentials/tokens
# from log output before they reach the console.
NEURALSTRIKE_REDACT_LOGS=true

# --- SecurityScarletAI exercise telemetry (fleet Wave 2, OPT-IN) ---
# Set BOTH keys to emit exercise telemetry (exercise_start / probe_* /
# exercise_end) to Scarlet's ingest endpoint. scarletai_url is the FULL
# ingest endpoint (the same knob semantics as NeuralGuard's
# NEURALGUARD_SIEM_SCARLETAI_URL); the token is the scoped
# INGEST_BEARER_TOKEN (viewer-class: ingest-router-only, cannot browse the
# SIEM). A partial config is a validation error — never a silent half-pipe.
# Telemetry is best-effort: a dead SIEM never fails an exercise.
# NEURALSTRIKE_SCARLETAI_URL=http://localhost:8000/api/v1/ingest
# NEURALSTRIKE_SCARLETAI_TOKEN=<ingest-bearer-token>
# The exercise actor (user_name slot — the attribution join key with
# NeuralGuard verdict events for the purple-report join):
# NEURALSTRIKE_TELEMETRY_ACTOR=neuralstrike-operator

# --- NeuralGuard screen credential (fleet Wave 3, the live firewall) ---
# The API key the bench sends as 'Authorization: Bearer <key>'. Accepts the
# documented NeuralGuard '<key>|<tenant>' form and derives BOTH parts (the
# fleet shares NEURALGUARD_AUTH_API_KEYS verbatim — shared once). The
# tenant MUST match the key's binding (NG 403s a mismatch when
# enforce_tenant_from_key is on — the fleet default).
# NEURALSTRIKE_NEURALGUARD_API_KEY=<ng-api-key-or-key|tenant>
# NEURALSTRIKE_NEURALGUARD_TENANT=default

# --- SecurityScarletAI purple-report read path (fleet Wave 3, OPT-IN) ---
# The purple-report queries GET /api/v1/alerts + GET /api/v1/logs — the
# ADMIN-class API token (NOT the scoped ingest token: that one is
# ingest-router-only BY DESIGN and cannot read). base_url is Scarlet's
# ROOT. Set BOTH together (a partial config is a validation error); the
# token is never logged.
# NEURALSTRIKE_SCARLETAI_BASE_URL=http://localhost:8000
# NEURALSTRIKE_SCARLETAI_API_TOKEN=<api-bearer-token>